# ==============================================================================
# الملف: .gitignore
# الوظيفة: استبعاد الملفات المؤقتة والمخرجات والبيانات المحلية ومفاتيح
#          التوقيع الحساسة من مستودع Git.
# ==============================================================================

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.cache
.DS_Store
.atom/
.buildlog/
.history
.svn/
.gradle/
.idea/
*.iml
*.ipr
*.iws
*.jks
*.keystore
*.p12
*.key

# Secrets & signing properties
android/key.properties
local.properties

# Flutter / Dart / Pub
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
flutter_*.png

# Symbolication
app.*.symbols

# Coverage
coverage/

# Obfuscation
app.*.map.*
app.*.dSYM.*
